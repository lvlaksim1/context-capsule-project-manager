{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Capsule metadata v2 development",
  "type": "object",
  "required": ["schema", "version", "source", "core_commit", "installed_at", "repository", "update_policy"],
  "properties": {
    "schema": {"const": "context-capsule"},
    "version": {"const": "2.0.0-dev"},
    "source": {"const": "lvlaksim1/context-capsule"},
    "core_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "installed_at": {"type": "string"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "update_policy": {"const": "manual"},
    "adopted_from": {"type": "string"}
  },
  "additionalProperties": true
}
